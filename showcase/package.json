{
  "name": "@devseed-ui/collecticons-showcase",
  "version": "3.1.0",
  "description": "Showcase site for Collecticons",
  "private": true,
  "scripts": {
    "static": "mkdir -p public && cp -r static/* public/",
    "serve": "yarn static && parcel src/index.html --dist-dir public --cache-dir .parcel-cache -p 9000",
    "build": "yarn static && parcel build src/index.html --dist-dir public --cache-dir .parcel-cache",
    "ts-check": "tsc --noEmit",
    "clean": "rm -rf .parcel-cache public",
    "lint": "eslint ./src --no-error-on-unmatched-pattern"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.8.1",
    "@devseed-ui/collecticons-chakra": "workspace:*",
    "@emotion/react": "^11.14.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@parcel/config-default": "^2.12.0",
    "@parcel/core": "^2.12.0",
    "@parcel/transformer-typescript-tsc": "^2.12.0",
    "@types/react": ">=18.0.0",
    "@types/react-dom": ">=18.0.0",
    "clipboard": "^2.0.11",
    "parcel": "^2.12.0",
    "prettier": "^3.3.2",
    "process": "^0.11.10",
    "typescript": "^5.4.5"
  }
}

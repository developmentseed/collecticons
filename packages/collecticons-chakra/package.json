{
  "name": "@devseed-ui/collecticons-chakra",
  "version": "4.0.0",
  "description": "devseed UI Kit Collecticons for Chakra",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "rollup -c ../../rollup.config.mjs",
    "watch": "rollup -c ../../rollup.config.mjs -w",
    "clean": "rm -rf ./dist ./lib/icons",
    "ts-check": "tsc --noEmit",
    "lint": "eslint ./lib --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/developmentseed/collecticons.git"
  },
  "peerDependencies": {
    "@chakra-ui/react": "^3.8.1",
    "@emotion/react": "^11.14.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": ">=18.0.0",
    "@types/react-dom": ">=18.0.0",
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "dependencies": {
    "clipboard": "^2.0.11"
  },
  "keywords": [
    "css",
    "framework",
    "front-end",
    "chakra",
    "react",
    "icons",
    "collecticons"
  ]
}
